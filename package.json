{
  "name": "zynvex-enterprise",
  "version": "1.0.0",
  "private": true,
  "description": "ZYNVEX Enterprise - Autonomous Intelligence Network",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace web",
    "test": "npm run test --workspace web",
    "test:e2e": "npm run test:e2e --workspace web",
    "prisma:generate": "npm run prisma:generate --workspace web",
